---
import type { SiteContent } from "../i18n/types";
import NoteStack from "./NoteStack";
import { icons } from "../icons";

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const { problem } = content;
---

<section id="problem" class="section problem">
  <div class="shell grid">
    <div class="intro">
      <h2 class="section-title">{problem.title}</h2>
      <p class="section-lead">{problem.lead}</p>
    </div>
    <div class="stack">
      <NoteStack
        client:visible
        notes={problem.notes}
        next={problem.next}
        counter={problem.counter}
        dragHint={problem.dragHint}
        doneTitle={problem.doneTitle}
        doneText={problem.doneText}
        doneCta={problem.doneCta}
        restart={problem.restart}
        arrowIcon={icons["arrow-right"]}
        downIcon={icons["arrow-down"]}
      />
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .stack {
    width: 100%;
    max-width: 30rem;
    justify-self: center;
  }

  @media (min-width: 60rem) {
    .grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 4rem;
    }

    .stack {
      justify-self: end;
    }
  }
</style>
