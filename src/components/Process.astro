---
import type { SiteContent } from "../i18n/types";
import Icon from "./Icon.astro";

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const { process } = content;
---

<section id="process" class="section process">
  <div class="shell">
    <header class="head">
      <h2 class="section-title">{process.title}</h2>
      <p class="section-lead">{process.lead}</p>
    </header>
    <div class="timeline">
      <span class="rail" aria-hidden="true"><span class="rail-fill"></span></span>
      <ol class="steps">
        {
          process.steps.map((step) => (
            <li class="step">
              <span class="dot" aria-hidden="true">
                <Icon name={step.icon} />
              </span>
              <h3 class="step-title">{step.title}</h3>
              <p class="step-text">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .head {
    margin-bottom: clamp(3rem, 2rem + 3vw, 4.5rem);
  }

  .timeline {
    position: relative;
  }

  .rail {
    position: absolute;
    left: 1.5rem;
    top: 1.5rem;
    bottom: 1.5rem;
    width: 1px;
    background-color: var(--color-line);
  }

  .rail-fill {
    position: absolute;
    inset: 0;
    background-color: var(--color-accent);
    transform-origin: top;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2.5rem;
  }

  .step {
    position: relative;
    display: grid;
    grid-template-columns: 3rem 1fr;
    column-gap: 1.25rem;
    align-items: start;
  }

  .dot {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 9999px;
    border: 1px solid var(--color-accent);
    background-color: var(--color-background);
    color: var(--color-accent);
    font-size: 1.25rem;
    position: relative;
    z-index: 1;
  }

  .step-title {
    margin: 0.55rem 0 0.4rem;
    font-size: var(--text-h3);
    line-height: var(--text-h3--line-height);
    letter-spacing: var(--text-h3--letter-spacing);
    font-weight: 680;
  }

  .step-text {
    margin: 0;
    color: var(--color-foreground-muted);
    max-width: 30ch;
  }

  @supports (animation-timeline: view()) {
    .rail-fill {
      animation: fill-vertical linear both;
      animation-timeline: view();
      animation-range: entry 60% cover 70%;
    }

    .dot {
      animation: light-up linear both;
      animation-timeline: view();
      animation-range: entry 80% cover 42%;
    }

    .step-title,
    .step-text {
      animation: settle linear both;
      animation-timeline: view();
      animation-range: entry 70% cover 35%;
    }
  }

  @keyframes fill-vertical {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }

  @keyframes fill-horizontal {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @keyframes light-up {
    0% {
      border-color: var(--color-line-strong);
      color: var(--color-foreground-muted);
      background-color: var(--color-background);
      transform: scale(0.9);
    }
    100% {
      border-color: var(--color-accent);
      color: var(--color-accent-foreground);
      background-color: var(--color-accent);
      transform: none;
    }
  }

  @keyframes settle {
    from {
      opacity: 0.25;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (min-width: 60rem) {
    .rail {
      left: 1.5rem;
      right: 1.5rem;
      top: 1.5rem;
      bottom: auto;
      width: auto;
      height: 1px;
    }

    .rail-fill {
      transform-origin: left;
    }

    @supports (animation-timeline: view()) {
      .rail-fill {
        animation-name: fill-horizontal;
        animation-range: entry 90% cover 60%;
      }
    }

    .steps {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1.5rem;
    }

    .step {
      grid-template-columns: 1fr;
    }

    .dot {
      grid-row: auto;
      margin-bottom: 1.25rem;
    }

    .step-title {
      margin-top: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rail-fill,
    .dot,
    .step-title,
    .step-text {
      animation: none !important;
    }
  }
</style>
