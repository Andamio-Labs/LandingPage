---
import type { SiteContent } from "../i18n/types";

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
---

<section id="problem" class="problem">
  <div class="inner">
    <h2>{content.problem.title}</h2>
    <p class="intro">{content.problem.intro}</p>
    <ul class="points">
      {content.problem.points.map((point) => <li>{point}</li>)}
    </ul>
  </div>
</section>

<style>
  .problem {
    padding: 4rem 1.25rem;
    background-color: var(--color-surface);
  }

  .inner {
    max-width: 48rem;
    margin-inline: auto;
  }

  h2 {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    margin: 0 0 1rem;
  }

  .intro {
    color: var(--color-foreground-muted);
    font-size: 1.05rem;
    margin: 0 0 2rem;
  }

  .points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .points li {
    position: relative;
    padding-left: 1.75rem;
    font-size: 1rem;
    line-height: 1.5;
  }

  .points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.4rem;
    width: 0.6rem;
    height: 0.6rem;
    background-color: var(--color-error);
    clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%);
  }
</style>
