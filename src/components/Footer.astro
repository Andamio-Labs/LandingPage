---
import type { SiteContent } from "../i18n/types";
import Logo from "./Logo.astro";

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="shell bar">
    <div class="left">
      <Logo />
      <span class="tagline">{content.footer.tagline} &copy; {year}</span>
    </div>
    <nav aria-label={content.header.navLabel}>
      <ul>
        {
          content.header.nav.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-line);
    padding-block: 2rem;
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
  }

  .left {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }

  .tagline {
    font-size: 0.875rem;
    color: var(--color-foreground-muted);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    font-size: 0.875rem;
    color: var(--color-foreground-muted);
    text-decoration: none;
    transition: color var(--duration-ui) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    a:hover {
      color: var(--color-foreground);
    }
  }
</style>
