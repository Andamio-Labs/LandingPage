---
import type { SiteContent } from "../i18n/types";
import QuoteBuilder from "./QuoteBuilder";
import { icons } from "../icons";
import { contact } from "../data/contact";

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const { quote } = content;
---

<section id="quote" class="section quote-section">
  <div class="shell">
    <header class="head">
      <h2 class="section-title">{quote.title}</h2>
      <p class="section-lead">{quote.lead}</p>
    </header>
    <QuoteBuilder
      client:visible
      copy={quote}
      businessOptions={content.audiences.items.map((item) => item.label)}
      needsOptions={content.solutions.items.map((item) => item.title)}
      whatsappNumber={contact.whatsappNumber}
      email={contact.email}
      glyphs={{ whatsapp: icons["whatsapp-logo"], envelope: icons["envelope-simple"], check: icons.check }}
    />
  </div>
</section>

<style>
  .quote-section {
    background-color: var(--color-surface);
    border-block: 1px solid var(--color-line);
  }

  .head {
    margin-bottom: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }
</style>
