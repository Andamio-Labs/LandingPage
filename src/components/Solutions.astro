---
import type { SiteContent } from "../i18n/types";
import SolutionExplorer from "./SolutionExplorer";
import { icons } from "../icons";

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const { solutions } = content;
const items = solutions.items.map((item) => ({ ...item, icon: icons[item.icon] }));
const glyphs = {
  plus: icons.plus,
  minus: icons.minus,
  check: icons.check,
  mapPin: icons["map-pin"],
  chat: icons["chat-circle-dots"],
};
---

<section id="solutions" class="section solutions">
  <div class="shell">
    <header class="head">
      <h2 class="section-title">{solutions.title}</h2>
      <p class="section-lead">{solutions.lead}</p>
    </header>
    <SolutionExplorer client:visible tabsLabel={solutions.tabsLabel} items={items} previews={solutions.previews} glyphs={glyphs} />
  </div>
</section>

<style>
  .head {
    margin-bottom: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    max-width: 52rem;
  }
</style>
