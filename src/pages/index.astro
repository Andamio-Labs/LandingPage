---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Problem from "../components/Problem.astro";
import Solutions from "../components/Solutions.astro";
import Audiences from "../components/Audiences.astro";
import Projects from "../components/Projects.astro";
import Process from "../components/Process.astro";
import Team from "../components/Team.astro";
import Faq from "../components/Faq.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import { content } from "../i18n";

const site = content.es;
---

<Layout content={site} canonicalPath="/">
  <Header content={site} />
  <main id="main-content">
    <Hero content={site} />
    <Problem content={site} />
    <Solutions content={site} />
    <Audiences content={site} />
    <Projects content={site} />
    <Process content={site} />
    <Team content={site} />
    <Faq content={site} />
    <Contact content={site} />
  </main>
  <Footer content={site} />
</Layout>
