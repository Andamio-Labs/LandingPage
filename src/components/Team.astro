---
import { Image } from "astro:assets";
import type { SiteContent } from "../i18n/types";
import { team } from "../data/team";
import Icon from "./Icon.astro";
import brandMark from "../assets/brand/mark.png";

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const lang = content.lang;
const strapText = Array.from({ length: 6 }, () => content.team.badgeOrg).join("  ");
---

<section id="team" class="section team">
  <div class="shell">
    <header class="head">
      <h2 class="section-title">{content.team.title}</h2>
      <p class="section-lead">{content.team.lead}</p>
    </header>
  </div>

  <div class="rig" data-badge-rig>
    <span class="pipe" aria-hidden="true"></span>
    <ul class="hangers">
      {
        team.map((member, index) => (
          <li class="slot">
          <span class="pipe-mobile" aria-hidden="true" />
          <div class="hanger" data-hanger style={`--index: ${index}`}>
            <span class="strap" aria-hidden="true">
              <span class="strap-text">{strapText}</span>
            </span>
            <span class="clip" aria-hidden="true" />
            <article class="badge" data-badge>
              <div class="badge-top">
                <span class="badge-org">{content.team.badgeOrg}</span>
                <Image src={brandMark} alt="" width={48} height={46} format="png" class="badge-mark" />
              </div>
              <div class="photo">
                {member.photo ? (
                  <Image src={member.photo} alt={member.name} width={320} height={240} class="photo-img" draggable="false" />
                ) : (
                  <span class="initials" aria-hidden="true">
                    {member.initials}
                  </span>
                )}
              </div>
              <h3 class="name">{member.name}</h3>
              <p class="role">{member.role[lang]}</p>
              {(member.github || member.linkedin || member.portfolio) && (
              <div class="links">
                {member.github && (
                  <a href={`https://github.com/${member.github}`} target="_blank" rel="noopener noreferrer" aria-label={`GitHub, ${member.name}`}>
                    <Icon name="github-logo" />
                  </a>
                )}
                {member.linkedin && (
                  <a
                    href={`https://www.linkedin.com/in/${member.linkedin}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`LinkedIn, ${member.name}`}
                  >
                    <Icon name="linkedin-logo" />
                  </a>
                )}
                {member.portfolio && (
                  <a class="text-link" href={member.portfolio} target="_blank" rel="noopener noreferrer">
                    {content.team.portfolio}
                    <Icon name="arrow-up-right" />
                  </a>
                )}
              </div>
              )}
            </article>
          </div>
          </li>
        ))
      }
    </ul>
    <p class="hint mono-label" aria-hidden="true">
      <Icon name="hand-grabbing" />
      {content.team.dragHint}
    </p>
  </div>
</section>

<style>
  .head {
    margin-bottom: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }

  .rig {
    position: relative;
    max-width: 80rem;
    margin-inline: auto;
    padding-inline: var(--spacing-gutter);
  }

  .pipe {
    position: absolute;
    left: var(--spacing-gutter);
    right: var(--spacing-gutter);
    top: 0;
    height: 0.6rem;
    border-radius: 9999px;
    background: linear-gradient(180deg, var(--color-line-strong), var(--color-line));
    box-shadow: 0 6px 14px -8px rgb(0 0 0 / 0.6);
  }

  .slot {
    display: grid;
    justify-items: center;
  }

  .pipe-mobile {
    width: min(18rem, 86vw);
    height: 0.55rem;
    border-radius: 9999px;
    background: linear-gradient(180deg, var(--color-line-strong), var(--color-line));
  }

  .pipe {
    display: none;
  }

  .hangers {
    list-style: none;
    margin: 0;
    padding: 0.3rem 0 0;
    display: grid;
    gap: 0;
    justify-items: center;
  }

  .hanger {
    --strap: 4.5rem;
    position: relative;
    display: grid;
    justify-items: center;
    transform-origin: 50% 0;
    will-change: transform;
    padding-bottom: 2.5rem;
  }

  .strap {
    position: relative;
    width: 1.35rem;
    height: var(--strap);
    background-color: var(--navy-900);
    overflow: hidden;
    display: grid;
    justify-items: center;
  }

  .strap-text {
    writing-mode: vertical-rl;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    color: var(--teal-300);
    white-space: nowrap;
    line-height: 1.35rem;
  }

  .clip {
    width: 2.6rem;
    height: 0.9rem;
    margin-top: -0.25rem;
    position: relative;
    z-index: 1;
    border-radius: 0.2rem 0.2rem 0.4rem 0.4rem;
    background: linear-gradient(180deg, var(--navy-300), var(--navy-500));
  }

  .badge {
    position: relative;
    width: min(16.5rem, 78vw);
    margin-top: -0.95rem;
    padding: 1rem 1rem 1.1rem;
    border-radius: 0.9rem;
    background-color: var(--color-paper);
    color: var(--color-ink);
    --logo-teal: #166462;
    --logo-navy: #28313b;
    --logo-fill: var(--color-paper);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.25) inset,
      0 28px 50px -24px rgb(3 8 10 / 0.7);
    touch-action: none;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .badge::before {
    content: "";
    position: absolute;
    top: 0.55rem;
    left: 50%;
    width: 2.2rem;
    height: 0.4rem;
    translate: -50% 0;
    border-radius: 9999px;
    background-color: color-mix(in srgb, var(--color-ink) 16%, transparent);
  }

  .badge:active {
    cursor: grabbing;
  }

  .badge-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0.45rem 0 0.8rem;
  }

  .badge-org {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--color-ink-muted);
  }

  .badge :global(.badge-mark) {
    width: 1.5rem;
    height: auto;
    pointer-events: none;
  }

  .photo {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    border-radius: 0.5rem;
    overflow: hidden;
    background-color: color-mix(in srgb, var(--color-ink) 7%, transparent);
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0,
      transparent 6px,
      color-mix(in srgb, var(--color-ink) 7%, transparent) 6px,
      color-mix(in srgb, var(--color-ink) 7%, transparent) 7px
    );
  }

  .photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  .initials {
    font-size: 3.4rem;
    font-weight: 800;
    font-stretch: 115%;
    letter-spacing: -0.05em;
    color: color-mix(in srgb, var(--color-ink) 32%, transparent);
  }

  .name {
    margin: 0.9rem 0 0.15rem;
    font-size: 1.3rem;
    line-height: 1.1;
    letter-spacing: -0.025em;
    font-weight: 750;
  }

  .role {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-ink-muted);
  }

  .links {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.95rem;
    padding-top: 0.8rem;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
  }

  .links a {
    display: inline-grid;
    place-items: center;
    min-width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.4rem;
    color: var(--color-ink);
    font-size: 1.15rem;
    text-decoration: none;
    transition: background-color var(--duration-ui) ease;
  }

  .links a.text-link {
    display: inline-flex;
    gap: 0.3rem;
    margin-left: auto;
    padding-inline: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .links a:focus-visible {
    outline-color: var(--teal-600);
  }

  @media (hover: hover) and (pointer: fine) {
    .links a:hover {
      background-color: color-mix(in srgb, var(--color-ink) 8%, transparent);
    }
  }

  .hint {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin: 0.5rem 0 0;
  }

  @media (min-width: 52rem) {
    .pipe {
      display: block;
    }

    .pipe-mobile {
      display: none;
    }

    .hangers {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .hanger {
      --strap: 7rem;
    }

    .hanger:nth-child(2) {
      --strap: 10rem;
    }
  }
</style>

<script>
  import { Spring, prefersReducedMotion, rubberband } from "../scripts/spring";

  function setupRig(rig: HTMLElement) {
    const reduced = prefersReducedMotion();
    const hangers = Array.from(rig.querySelectorAll<HTMLElement>("[data-hanger]"));

    const states = hangers.map((hanger, index) => {
      const badge = hanger.querySelector<HTMLElement>("[data-badge]")!;
      return {
        hanger,
        badge,
        angle: new Spring(0, { response: 0.95, damping: 0.38 }),
        drop: new Spring(0, { response: 0.7, damping: 0.55 }),
        dragging: false,
        moved: false,
        pointerId: -1,
        lastAngle: 0,
        lastTime: 0,
        angularVelocity: 0,
        startX: 0,
        startY: 0,
        index,
      };
    });

    let frame = 0;
    let last = performance.now();

    function render() {
      states.forEach((state) => {
        state.hanger.style.transform = `translate3d(0, ${state.drop.value}%, 0) rotate(${state.angle.value}deg)`;
      });
    }

    function tick(now: number) {
      const delta = (now - last) / 1000;
      last = now;
      let active = false;
      states.forEach((state) => {
        if (!state.dragging) state.angle.step(delta);
        state.drop.step(delta);
        if (state.dragging || !state.angle.settled || !state.drop.settled) active = true;
      });
      render();
      frame = active ? requestAnimationFrame(tick) : 0;
    }

    function start() {
      if (frame) return;
      last = performance.now();
      frame = requestAnimationFrame(tick);
    }

    function angleFor(state: (typeof states)[number], event: PointerEvent) {
      const rigRect = rig.getBoundingClientRect();
      const pivotX = rigRect.left + state.hanger.offsetLeft + state.hanger.offsetWidth / 2;
      const pivotY = rigRect.top + state.hanger.offsetTop;
      const raw = (Math.atan2(event.clientX - pivotX, Math.max(event.clientY - pivotY, 40)) * 180) / Math.PI;
      const limit = 28;
      if (Math.abs(raw) <= limit) return -raw;
      const overshoot = Math.abs(raw) - limit;
      return -Math.sign(raw) * (limit + rubberband(overshoot, 90, 0.55));
    }

    states.forEach((state) => {
      state.badge.addEventListener("pointerdown", (event) => {
        if (state.dragging) return;
        state.dragging = true;
        state.moved = false;
        state.pointerId = event.pointerId;
        state.badge.setPointerCapture(event.pointerId);
        state.lastAngle = state.angle.value;
        state.lastTime = performance.now();
        state.startX = event.clientX;
        state.startY = event.clientY;
        start();
      });

      state.badge.addEventListener("pointermove", (event) => {
        if (state.dragging && event.pointerId === state.pointerId) {
          if (!state.moved && Math.hypot(event.clientX - state.startX, event.clientY - state.startY) < 6) return;
          state.moved = true;
          const next = angleFor(state, event);
          const now = performance.now();
          const dt = Math.max((now - state.lastTime) / 1000, 0.001);
          state.angularVelocity = state.angularVelocity * 0.4 + ((next - state.lastAngle) / dt) * 0.6;
          state.lastAngle = next;
          state.lastTime = now;
          state.angle.value = next;
          return;
        }
        if (!reduced && event.pointerType === "mouse" && !state.dragging) {
          state.angle.velocity += event.movementX * -0.25;
          start();
        }
      });

      const release = (event: PointerEvent) => {
        if (!state.dragging || event.pointerId !== state.pointerId) return;
        state.dragging = false;
        if (reduced) {
          state.angle.jump(0);
          render();
          return;
        }
        state.angle.velocity = state.moved ? state.angularVelocity : 0;
        start();
      };

      state.badge.addEventListener("pointerup", release);
      state.badge.addEventListener("pointercancel", release);
      state.badge.addEventListener(
        "click",
        (event) => {
          if (state.moved) {
            event.preventDefault();
            event.stopPropagation();
            state.moved = false;
          }
        },
        true
      );
    });

    if (reduced) return;

    states.forEach((state) => {
      state.drop.jump(-18);
      state.hanger.style.opacity = "0";
    });
    render();

    new IntersectionObserver(
      (entries, observer) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        states.forEach((state) => {
          window.setTimeout(() => {
            state.hanger.style.transition = "opacity 260ms ease";
            state.hanger.style.opacity = "1";
            state.drop.target = 0;
            state.angle.velocity = (state.index % 2 === 0 ? 1 : -1) * 30;
            start();
          }, state.index * 120);
        });
      },
      { threshold: 0.25 }
    ).observe(rig);
  }

  document.querySelectorAll<HTMLElement>("[data-badge-rig]").forEach(setupRig);
</script>
