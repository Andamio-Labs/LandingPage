---
import LogoMark from "./LogoMark.astro";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<span class={`logo ${className}`}>
  <LogoMark class="mark" strokeWidth={36} simple />
  <span class="word">Andamio Labs</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-foreground);
    white-space: nowrap;
  }

  .logo :global(.mark) {
    width: 2.1rem;
    flex-shrink: 0;
  }

  .word {
    font-family: "Montserrat Wordmark", var(--font-sans);
    font-weight: 600;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
  }
</style>
