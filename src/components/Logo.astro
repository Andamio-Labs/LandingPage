---
import { Image } from "astro:assets";
import mark from "../assets/brand/mark.png";
import markLight from "../assets/brand/mark-light.png";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<span class={`logo ${className}`}>
  <span class="mark" aria-hidden="true">
    <Image src={markLight} alt="" width={68} height={65} format="png" class="mark-on-dark" loading="eager" />
    <Image src={mark} alt="" width={68} height={65} format="png" class="mark-on-light" loading="eager" />
  </span>
  <span class="word">Andamio Labs</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-foreground);
    white-space: nowrap;
  }

  .mark {
    display: grid;
    width: 2.15rem;
    flex-shrink: 0;
  }

  .mark :global(img) {
    grid-area: 1 / 1;
    width: 100%;
    height: auto;
  }

  .mark :global(.mark-on-light) {
    display: none;
  }

  :global([data-theme="light"]) .mark :global(.mark-on-light) {
    display: block;
  }

  :global([data-theme="light"]) .mark :global(.mark-on-dark) {
    display: none;
  }

  .word {
    font-family: "Montserrat Wordmark", var(--font-sans);
    font-weight: 600;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
  }
</style>
