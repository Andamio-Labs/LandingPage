---
import type { SiteContent } from "../i18n/types";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const homeHref = content.lang === "es" ? "/" : "/en/";
---

<div class="scroll-sentinel" data-scroll-sentinel aria-hidden="true"></div>
<header class="header" data-header>
  <div class="shell bar">
    <a href={homeHref} class="brand" aria-label="Andamio Labs">
      <Logo />
    </a>

    <nav class="nav" aria-label={content.header.navLabel}>
      <ul>
        {
          content.header.nav.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="tools">
      <a
        class="lang"
        href={content.languageSwitch.href}
        hreflang={content.lang === "es" ? "en" : "es"}
        aria-label={content.languageSwitch.ariaLabel}
      >
        {content.languageSwitch.label}
      </a>
      <button
        type="button"
        class="icon-button theme-toggle"
        data-theme-toggle
        data-label-light={content.theme.toLight}
        data-label-dark={content.theme.toDark}
        aria-label={content.theme.toLight}
      >
        <Icon name="sun" class="theme-icon sun" />
        <Icon name="moon" class="theme-icon moon" />
      </button>
      <a class="button is-primary is-plain header-cta" href="#quote">{content.header.cta}</a>
      <button
        type="button"
        class="icon-button menu-toggle"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-label-open={content.header.menuOpen}
        data-label-close={content.header.menuClose}
        aria-label={content.header.menuOpen}
      >
        <span class="menu-lines" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <nav class="shell" aria-label={content.header.navLabel}>
      <ul>
        {
          content.header.nav.map((link, index) => (
            <li style={`--item: ${index}`}>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
      <a class="button is-primary mobile-cta" href="#quote" style={`--item: ${content.header.nav.length}`}>
        {content.header.cta}
        <span class="button-chip"><Icon name="arrow-right" /></span>
      </a>
    </nav>
  </div>
</header>

<style>
  .scroll-sentinel {
    position: absolute;
    top: 0;
    height: 8px;
    width: 1px;
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    transition:
      background-color var(--duration-medium) ease,
      border-color var(--duration-medium) ease,
      backdrop-filter var(--duration-medium) ease;
    border-bottom: 1px solid transparent;
  }

  .header.is-scrolled,
  .header.is-open {
    background-color: color-mix(in srgb, var(--color-background) 78%, transparent);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    border-bottom-color: var(--color-line);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4.5rem;
  }

  .brand {
    text-decoration: none;
    border-radius: 6px;
  }

  .nav {
    display: none;
  }

  .nav ul {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav a {
    position: relative;
    color: var(--color-foreground-muted);
    text-decoration: none;
    font-size: 0.975rem;
    font-weight: 500;
    transition: color var(--duration-ui) ease;
  }

  .nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.35rem;
    height: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--duration-medium) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav a:hover {
      color: var(--color-foreground);
    }

    .nav a:hover::after {
      transform: scaleX(1);
      transform-origin: left;
    }

    .icon-button:hover,
    .lang:hover {
      color: var(--color-foreground);
      background-color: var(--color-surface-high);
    }
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .lang,
  .icon-button {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-base);
    border: none;
    background: transparent;
    color: var(--color-foreground-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--duration-ui) ease,
      color var(--duration-ui) ease,
      transform var(--duration-press) var(--ease-out);
  }

  .lang:active,
  .icon-button:active {
    transform: scale(0.94);
  }

  .theme-toggle {
    position: relative;
  }

  .theme-toggle :global(.theme-icon) {
    position: absolute;
    width: 1.2rem;
    height: 1.2rem;
    transition:
      transform var(--duration-medium) var(--ease-out),
      opacity var(--duration-ui) ease;
  }

  .theme-toggle :global(.moon) {
    opacity: 0;
    transform: rotate(90deg) scale(0.5);
  }

  :global([data-theme="light"]) .theme-toggle :global(.sun) {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }

  :global([data-theme="light"]) .theme-toggle :global(.moon) {
    opacity: 1;
    transform: none;
  }

  .header-cta {
    display: none;
    min-height: 2.5rem;
    margin-left: 0.5rem;
    font-size: 0.925rem;
    padding: 0 1rem;
  }

  .menu-lines {
    position: relative;
    width: 1.1rem;
    height: 0.6rem;
  }

  .menu-lines span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    border-radius: 2px;
    background-color: currentColor;
    transition: transform var(--duration-medium) var(--ease-out), top var(--duration-medium) var(--ease-out);
  }

  .menu-lines span:first-child {
    top: 0;
  }

  .menu-lines span:last-child {
    top: calc(100% - 1.5px);
  }

  .menu-toggle[aria-expanded="true"] .menu-lines span:first-child {
    top: calc(50% - 0.75px);
    transform: rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"] .menu-lines span:last-child {
    top: calc(50% - 0.75px);
    transform: rotate(-45deg);
  }

  .mobile-menu {
    border-top: 1px solid var(--color-line);
    padding-block: 1rem 1.75rem;
  }

  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile-menu li,
  .mobile-cta {
    animation: menu-item 0.42s var(--ease-out) both;
    animation-delay: calc(var(--item) * 40ms);
  }

  .mobile-menu li a {
    display: block;
    padding: 0.65rem 0;
    font-size: var(--text-h3);
    font-weight: 650;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--color-foreground);
  }

  .mobile-cta {
    margin-top: 1.25rem;
  }

  @keyframes menu-item {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (min-width: 60rem) {
    .nav {
      display: block;
    }

    .header-cta {
      display: inline-flex;
    }

    .menu-toggle,
    .mobile-menu {
      display: none !important;
    }
  }
</style>

<script>
  import { prefersReducedMotion } from "../scripts/spring";

  const header = document.querySelector<HTMLElement>("[data-header]");
  const sentinel = document.querySelector<HTMLElement>("[data-scroll-sentinel]");
  if (header && sentinel) {
    new IntersectionObserver(([entry]) => {
      header.classList.toggle("is-scrolled", !entry.isIntersecting);
    }).observe(sentinel);
  }

  const themeToggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");

  function currentTheme() {
    return document.documentElement.dataset.theme === "light" ? "light" : "dark";
  }

  function syncThemeLabel() {
    if (!themeToggle) return;
    const label = currentTheme() === "light" ? themeToggle.dataset.labelDark : themeToggle.dataset.labelLight;
    themeToggle.setAttribute("aria-label", label ?? "");
  }

  function applyTheme(theme: "light" | "dark") {
    if (theme === "light") document.documentElement.dataset.theme = "light";
    else delete document.documentElement.dataset.theme;
    try {
      localStorage.setItem("theme", theme);
    } catch (error) {}
    syncThemeLabel();
  }

  themeToggle?.addEventListener("click", () => {
    const next = currentTheme() === "light" ? "dark" : "light";
    const doc = document as Document & { startViewTransition?: (callback: () => void) => { ready: Promise<void> } };
    if (!doc.startViewTransition || prefersReducedMotion()) {
      applyTheme(next);
      return;
    }
    const rect = themeToggle.getBoundingClientRect();
    const x = rect.left + rect.width / 2;
    const y = rect.top + rect.height / 2;
    const radius = Math.hypot(Math.max(x, window.innerWidth - x), Math.max(y, window.innerHeight - y));
    const transition = doc.startViewTransition(() => applyTheme(next));
    transition.ready.then(() => {
      document.documentElement.animate(
        { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
        { duration: 520, easing: "cubic-bezier(0.77, 0, 0.175, 1)", pseudoElement: "::view-transition-new(root)" }
      );
    });
  });

  syncThemeLabel();

  const menuToggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const mobileMenu = document.querySelector<HTMLElement>("[data-mobile-menu]");

  function setMenu(open: boolean) {
    if (!menuToggle || !mobileMenu || !header) return;
    menuToggle.setAttribute("aria-expanded", String(open));
    menuToggle.setAttribute("aria-label", (open ? menuToggle.dataset.labelClose : menuToggle.dataset.labelOpen) ?? "");
    mobileMenu.hidden = !open;
    header.classList.toggle("is-open", open);
  }

  menuToggle?.addEventListener("click", () => setMenu(menuToggle.getAttribute("aria-expanded") !== "true"));
  mobileMenu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setMenu(false)));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menuToggle?.getAttribute("aria-expanded") === "true") {
      setMenu(false);
      menuToggle.focus();
    }
  });
</script>
