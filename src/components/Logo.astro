---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<span class={`logo ${className}`}>
  <svg class="mark" viewBox="-2 -2 104 120" aria-hidden="true" focusable="false">
    <polygon class="top" points="50,0 100,29 50,58 0,29"></polygon>
    <polygon class="left" points="0,29 50,58 50,116 0,87"></polygon>
    <polygon class="right" points="100,29 50,58 50,116 100,87"></polygon>
  </svg>
  <span class="word">Andamio Labs</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-foreground);
    font-weight: 700;
    font-stretch: 108%;
    font-size: 1.075rem;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .mark {
    width: 1.35rem;
    height: 1.55rem;
    flex-shrink: 0;
  }

  .top {
    fill: var(--c-cube-top);
  }

  .left {
    fill: var(--c-cube-left);
  }

  .right {
    fill: var(--c-cube-right);
  }
</style>
