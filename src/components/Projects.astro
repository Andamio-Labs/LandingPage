---
import type { SiteContent } from "../i18n/types";
import { projects } from "../data/projects";
import BookingDemo from "./BookingDemo";

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const lang = content.lang;
---

<section id="projects" class="projects">
  <div class="inner">
    <h2>{content.projectsSection.title}</h2>
    <p class="intro">{content.projectsSection.intro}</p>

    <ul class="project-grid">
      {
        projects.map((project) => (
          <li class="project-card">
            <h3>{project.name}</h3>
            <p>{project.description[lang]}</p>
            <ul class="tags">
              {project.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
            <a class="project-link" href={project.demoUrl} target="_blank" rel="noopener noreferrer">
              {content.projectsSection.ctaLabel}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="demo-panel">
      <h3>{content.projectsSection.demo.title}</h3>
      <p>{content.projectsSection.demo.description}</p>
      <BookingDemo
        client:visible
        days={content.projectsSection.demo.days}
        dayLabel={content.projectsSection.demo.dayLabel}
        timeLabel={content.projectsSection.demo.timeLabel}
        availableLabel={content.projectsSection.demo.availableLabel}
        availableLabelSingular={content.projectsSection.demo.availableLabelSingular}
        fullLabel={content.projectsSection.demo.fullLabel}
        confirmLabel={content.projectsSection.demo.confirmLabel}
        confirmedMessage={content.projectsSection.demo.confirmedMessage}
        selectPrompt={content.projectsSection.demo.selectPrompt}
      />
    </div>
  </div>
</section>

<style>
  .projects {
    padding: 4rem 1.25rem;
  }

  .inner {
    max-width: 72rem;
    margin-inline: auto;
  }

  h2 {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    margin: 0 0 1rem;
  }

  .intro {
    color: var(--color-foreground-muted);
    font-size: 1.05rem;
    margin: 0 0 2.5rem;
    max-width: 48ch;
  }

  .project-grid {
    list-style: none;
    margin: 0 0 3rem;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }

  .project-card {
    padding: 1.75rem;
    border-radius: 1rem;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .project-card h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .project-card p {
    margin: 0;
    color: var(--color-foreground-muted);
    font-size: 0.9rem;
    line-height: 1.5;
    flex-grow: 1;
  }

  .tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tags li {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    border-radius: 9999px;
    background-color: var(--color-background);
    color: var(--color-foreground-muted);
  }

  .project-link {
    color: var(--color-accent);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
  }

  .project-link:hover {
    text-decoration: underline;
  }

  .demo-panel {
    padding: 2rem;
    border-radius: 1.25rem;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
  }

  .demo-panel h3 {
    margin: 0 0 0.4rem;
    font-size: 1.25rem;
  }

  .demo-panel > p {
    margin: 0 0 1.5rem;
    color: var(--color-foreground-muted);
    font-size: 0.95rem;
  }
</style>
