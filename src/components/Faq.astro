---
import type { SiteContent } from "../i18n/types";
import Icon from "./Icon.astro";

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
---

<section id="faq" class="section faq">
  <div class="shell grid">
    <h2 class="section-title">{content.faq.title}</h2>
    <div class="list">
      {
        content.faq.items.map((item) => (
          <details class="item" name="faq">
            <summary>
              <span>{item.question}</span>
              <span class="toggle" aria-hidden="true">
                <Icon name="plus" />
              </span>
            </summary>
            <div class="answer">
              <p>{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 2.5rem;
  }

  .list {
    border-top: 1px solid var(--color-line);
  }

  .item {
    border-bottom: 1px solid var(--color-line);
    interpolate-size: allow-keywords;
  }

  .item::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size var(--duration-medium) var(--ease-out),
      content-visibility var(--duration-medium) allow-discrete;
  }

  .item[open]::details-content {
    block-size: auto;
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.4rem 0;
    cursor: pointer;
    list-style: none;
    font-size: var(--text-h3);
    line-height: var(--text-h3--line-height);
    letter-spacing: var(--text-h3--letter-spacing);
    font-weight: 620;
    border-radius: 4px;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .toggle {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-base);
    border: 1px solid var(--color-line-strong);
    font-size: 1rem;
    transition:
      transform var(--duration-medium) var(--ease-out),
      background-color var(--duration-ui) ease,
      color var(--duration-ui) ease,
      border-color var(--duration-ui) ease;
  }

  .item[open] .toggle {
    transform: rotate(45deg);
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-foreground);
  }

  .answer p {
    margin: 0;
    padding: 0 3.5rem 1.6rem 0;
    color: var(--color-foreground-muted);
    font-size: var(--text-lead);
    line-height: 1.5;
    max-width: 58ch;
  }

  @media (hover: hover) and (pointer: fine) {
    summary:hover .toggle {
      border-color: var(--color-foreground);
    }
  }

  @media (min-width: 60rem) {
    .grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 4rem;
      align-items: start;
    }
  }
</style>
