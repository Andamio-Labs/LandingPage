---
import { boxGeometry, faceMatrix, logoGlyphs, logoStroke, type LogoBox } from "../data/logo";

interface Props {
  box: LogoBox;
  glyphs?: boolean;
  viewBox?: string;
  strokeWidth?: number;
}

const { box, glyphs = true, strokeWidth = logoStroke } = Astro.props;
const geometry = boxGeometry(box);
const viewBox = Astro.props.viewBox ?? `${geometry.bounds.x} ${geometry.bounds.y} ${geometry.bounds.width} ${geometry.bounds.height}`;
const pieceGlyphs = glyphs ? logoGlyphs.filter((glyph) => glyph.box === box.id) : [];
---

<svg class="logo-piece" viewBox={viewBox} aria-hidden="true" focusable="false" overflow="visible">
  {
    box.frameOnly ? (
      <g fill="none" stroke-width={strokeWidth} stroke-linejoin="round" stroke-linecap="round">
        <polyline points={geometry.frameLeft} stroke="var(--logo-teal)" />
        <polyline points={geometry.frameRight} stroke="var(--logo-navy)" />
      </g>
    ) : (
      <g
        fill="none"
        stroke={box.tone === "teal" ? "var(--logo-teal)" : "var(--logo-navy)"}
        stroke-width={strokeWidth}
        stroke-linejoin="round"
        stroke-linecap="round"
      >
        <polygon points={geometry.silhouette} fill={box.solid ? "var(--logo-fill)" : "none"} />
        <polyline points={geometry.inner} />
        <polyline points={geometry.spine} />
        {geometry.belt && <polyline points={geometry.belt} />}
      </g>
    )
  }
  {
    pieceGlyphs.map((glyph) => (
      <text
        transform={`matrix(${faceMatrix[glyph.face]} ${glyph.at[0]} ${glyph.at[1]})`}
        font-size={glyph.size}
        fill={glyph.tone === "teal" ? "var(--logo-teal)" : "var(--logo-navy)"}
        class="logo-glyph"
        text-anchor="middle"
        dominant-baseline="central"
      >
        {glyph.text}
      </text>
    ))
  }
</svg>

<style>
  .logo-piece {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .logo-glyph {
    font-family: var(--font-mono);
    font-weight: 700;
  }
</style>
