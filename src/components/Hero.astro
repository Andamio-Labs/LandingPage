---
import type { SiteContent } from "../i18n/types";

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
---

<section id="hero" class="hero">
  <div class="hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">{content.hero.eyebrow}</p>
      <h1>{content.hero.title}</h1>
      <p class="subtitle">{content.hero.subtitle}</p>
      <div class="cta-row">
        <a class="cta-primary" href={content.hero.ctaPrimary.href} target="_blank" rel="noopener noreferrer">
          {content.hero.ctaPrimary.label}
        </a>
        <a class="cta-secondary" href={content.hero.ctaSecondary.href}>
          {content.hero.ctaSecondary.label}
        </a>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="grid-lines"></div>
      <div class="cube cube-1">
        <svg viewBox="0 0 100 90" class="cube-svg">
          <polygon class="face face-top" points="50,21.8 90,33.4 50,45 10,33.4" />
          <polygon class="face face-left" points="10,33.4 50,45 50,68.2 10,56.6" />
          <polygon class="face face-right" points="90,33.4 50,45 50,68.2 90,56.6" />
        </svg>
      </div>
      <div class="cube cube-2">
        <svg viewBox="0 0 100 90" class="cube-svg">
          <polygon class="face face-top" points="50,21.8 90,33.4 50,45 10,33.4" />
          <polygon class="face face-left" points="10,33.4 50,45 50,68.2 10,56.6" />
          <polygon class="face face-right" points="90,33.4 50,45 50,68.2 90,56.6" />
        </svg>
      </div>
      <div class="cube cube-3 cube-filled">
        <svg viewBox="0 0 100 90" class="cube-svg">
          <polygon class="face face-top" points="50,21.8 90,33.4 50,45 10,33.4" />
          <polygon class="face face-left" points="10,33.4 50,45 50,68.2 10,56.6" />
          <polygon class="face face-right" points="90,33.4 50,45 50,68.2 90,56.6" />
          <text x="50" y="52" class="glyph">{"</>"}</text>
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 3.5rem 1.25rem 4rem;
    overflow: hidden;
  }

  .hero-inner {
    max-width: 72rem;
    margin-inline: auto;
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 0.75rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.1;
    margin: 0 0 1rem;
    max-width: 20ch;
  }

  .subtitle {
    font-size: 1.1rem;
    color: var(--color-foreground-muted);
    max-width: 42ch;
    margin: 0 0 2rem;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .cta-primary {
    border-radius: 9999px;
    background-color: var(--color-accent);
    color: var(--color-accent-foreground);
    text-decoration: none;
    font-weight: 600;
    padding: 0.85rem 1.75rem;
    transition:
      background-color 0.15s ease,
      transform 0.15s ease;
  }

  .cta-primary:hover {
    background-color: var(--color-accent-hover);
    transform: translateY(-1px);
  }

  .cta-secondary {
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    color: var(--color-foreground);
    text-decoration: none;
    font-weight: 600;
    padding: 0.85rem 1.75rem;
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .cta-secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .hero-visual {
    position: relative;
    height: 18rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .grid-lines {
    position: absolute;
    inset: 10%;
    background-image:
      linear-gradient(var(--color-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px);
    background-size: 2.5rem 2.5rem;
    opacity: 0.35;
    border-radius: 1.5rem;
  }

  .cube {
    position: absolute;
    width: 6.5rem;
    height: 5.5rem;
    opacity: 0;
    animation: assemble 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .cube-1 {
    top: 1rem;
    left: 50%;
    translate: -50% 0;
    animation-delay: 0.1s;
  }

  .cube-2 {
    top: 6.2rem;
    left: 22%;
    animation-delay: 0.32s;
  }

  .cube-3 {
    top: 6.2rem;
    right: 22%;
    animation-delay: 0.54s;
  }

  .cube-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .face {
    stroke: var(--color-accent);
    stroke-width: 1.5;
    stroke-linejoin: round;
    fill: color-mix(in srgb, var(--color-accent) 8%, transparent);
  }

  .cube-filled .face-top {
    fill: var(--color-accent);
    stroke: var(--color-accent);
  }

  .cube-filled .face-left {
    fill: var(--color-teal-800);
    stroke: var(--color-teal-800);
  }

  .cube-filled .face-right {
    fill: var(--color-teal-900);
    stroke: var(--color-teal-900);
  }

  .glyph {
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 600;
    fill: var(--color-accent-foreground);
    text-anchor: middle;
  }

  @keyframes assemble {
    from {
      opacity: 0;
      transform: translateY(-1.5rem) scale(0.85);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (min-width: 64rem) {
    .hero-inner {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 3rem;
    }

    .hero-visual {
      height: 22rem;
    }
  }
</style>
