---
import type { SiteContent } from "../i18n/types";
import CubeScene from "./CubeScene.astro";
import Icon from "./Icon.astro";

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
---

<section id="hero" class="hero">
  <div class="shell hero-grid">
    <div class="copy">
      <h1 class="title" aria-label={content.hero.titleLines.join(" ")}>
        {
          content.hero.titleLines.map((line, lineIndex) => (
            <span class="line" aria-hidden="true">
              <span class="line-inner" style={`--line: ${lineIndex}`}>
                {line}
              </span>
            </span>
          ))
        }
      </h1>
      <p class="lead">{content.hero.lead}</p>
      <div class="actions">
        <a class="button is-primary" href="#quote">
          {content.header.cta}
          <span class="button-chip"><Icon name="arrow-right" class="nudge-right" /></span>
        </a>
        <a class="button" href="#solutions">
          {content.hero.secondaryCta}
          <span class="button-chip"><Icon name="arrow-down" class="nudge-down" /></span>
        </a>
      </div>
    </div>
    <div class="visual">
      <CubeScene hint={content.hero.sceneHint} />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2.5rem, 1rem + 6vw, 6rem) clamp(3rem, 2rem + 4vw, 5rem);
    overflow: clip;
    isolation: isolate;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: -20% -10% auto;
    height: 90%;
    z-index: -1;
    background: radial-gradient(60% 55% at 30% 30%, color-mix(in srgb, var(--color-foreground) 6%, transparent), transparent 70%);
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .title {
    margin: 0;
    font-size: var(--text-display);
    line-height: var(--text-display--line-height);
    letter-spacing: var(--text-display--letter-spacing);
    font-weight: 800;
    font-stretch: 108%;
  }

  .line {
    display: block;
    overflow-x: visible;
    overflow-y: clip;
    padding-bottom: 0.06em;
    margin-bottom: -0.06em;
  }

  .line-inner {
    display: inline-block;
    animation: rise 1s var(--ease-out) both;
    animation-delay: calc(80ms + var(--line) * 110ms);
  }

  .lead {
    margin: 1.75rem 0 0;
    max-width: 34ch;
    font-size: var(--text-lead);
    line-height: 1.45;
    color: var(--color-foreground-muted);
    animation: fade-up 0.8s var(--ease-out) 0.35s both;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
    animation: fade-up 0.8s var(--ease-out) 0.45s both;
  }

  @keyframes rise {
    from {
      transform: translateY(105%);
    }
    to {
      transform: translateY(0);
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(12px);
      filter: blur(4px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }

  @media (min-width: 64rem) {
    .hero {
      min-height: calc(100dvh - 4.5rem);
      display: grid;
      align-items: center;
    }

    .hero-grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .line-inner,
    .lead,
    .actions {
      animation: none;
    }
  }
</style>
