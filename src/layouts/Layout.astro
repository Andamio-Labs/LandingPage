---
import "../styles/global.css";
import type { SiteContent } from "../i18n/types";
import { contact } from "../data/contact";
import { buildStructuredData } from "../data/structuredData";

interface Props {
  content: SiteContent;
  canonicalPath: string;
}

const { content, canonicalPath } = Astro.props;
const siteUrl = contact.siteUrl;
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const ogImageUrl = new URL("/og-image.png", siteUrl).toString();
const ogLocale = content.lang === "es" ? "es_CO" : "en_US";
const ogLocaleAlternate = content.lang === "es" ? "en_US" : "es_CO";
const structuredData = JSON.stringify(buildStructuredData(content.meta.description, content.htmlLang));
---

<!doctype html>
<html lang={content.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem("theme") === "light") document.documentElement.dataset.theme = "light";
        } catch (error) {}
      })();
    </script>
    <link rel="preload" href="/fonts/mona-sans-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-dark-32.png" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />

    <title>{content.meta.title}</title>
    <meta name="description" content={content.meta.description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Andamio Labs" />
    <meta property="og:title" content={content.meta.title} />
    <meta property="og:description" content={content.meta.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={content.meta.title} />
    <meta name="twitter:description" content={content.meta.description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="theme-color" content="#0e1316" />

    <link rel="alternate" hreflang="es" href={siteUrl + "/"} />
    <link rel="alternate" hreflang="en" href={siteUrl + "/en/"} />
    <link rel="alternate" hreflang="x-default" href={siteUrl + "/"} />

    <script type="application/ld+json" is:inline set:html={structuredData} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{content.skipLink}</a>
    <slot />
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.7rem 1.1rem;
    border-radius: var(--radius-base);
    background-color: var(--color-accent);
    color: var(--color-accent-foreground);
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-160%);
    transition: transform var(--duration-ui) var(--ease-out);
  }

  .skip-link:focus {
    transform: none;
  }
</style>
